# Пример окружения benchmark. Скопируйте в `.env` и заполните значения.
# Реальный `.env` игнорируется git; значения секретов не логируются.
#
# Загрузка идёт только из корня репозитория (`project_root()/.env`), с
# `override=False`: уже экспортированные переменные окружения имеют приоритет.

# --- model-gateway: единственная точка, где живёт ключ OpenRouter ---
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- host orchestrator: трассы Langfuse v4 ---
# Стек поднимается из docker/langfuse (make langfuse-up). Значения ключей
# должны совпадать с LANGFUSE_INIT_PROJECT_* файла docker/langfuse/.env.
LANGFUSE_URL=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- benchmark: модель, лимиты и образы ---
# BENCH_MODEL=deepseek/deepseek-v4-flash
# BENCH_PROVIDER=pgpro
# BENCH_MAX_TURNS=50
# BENCH_TEMPERATURE=0
# BENCH_AGENT_TIMEOUT=1800
# BENCH_CONTAINER_TIMEOUT=3600
# BENCH_TASK_IMAGE=db-pipeline-bench-postgres:local
# BENCH_GRAPH_IMAGE=db-pipeline-graph-postgres:local
# BENCH_OPENCODE_VERSION=v1.18.20
# BENCH_INTERNAL_NETWORK=bench-internal
