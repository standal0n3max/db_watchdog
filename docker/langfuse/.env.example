# Пример окружения локального стека Langfuse. Скопируйте в `.env` и заполните.
# Реальный `.env` игнорируется git (шаблон `.env` в корневом .gitignore).
#
# ВАЖНО: LANGFUSE_INIT_PROJECT_PUBLIC_KEY и LANGFUSE_INIT_PROJECT_SECRET_KEY
# задают ключи проекта при первом старте. Те же значения нужны в корневом
# `.env` как LANGFUSE_PUBLIC_KEY и LANGFUSE_SECRET_KEY.
# SALT и ENCRYPTION_KEY после первого старта менять нельзя: иначе сохранённые
# в базе ключи перестанут расшифровываться.
# ENCRYPTION_KEY генерируется через `openssl rand -hex 32`.

# --- postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/postgres

# --- clickhouse ---
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=

# --- redis ---
REDIS_AUTH=

# --- minio ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=

# --- langfuse-web ---
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
