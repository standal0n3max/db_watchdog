{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "pgpro": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Model Gateway",
      "options": {
        "baseURL": "http://model-gateway:8080/v1",
        "apiKey": "{env:POSTGRES_GYM_PROVIDER_KEY}"
      },
      "models": {
        "bench": {
          "name": "bench",
          "limit": { "context": 32768, "output": 4096 }
        }
      }
    }
  },
  "permission": {
    "webfetch": "deny",
    "external_directory": "deny"
  },
  "tools": {
    "webfetch": false
  }
}
